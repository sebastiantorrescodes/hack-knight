# Copy to .env and fill in. Only the first block is required.
API_URL=http://localhost:8000
API_KEY=changeme
SERIAL_PORT=/dev/ttyACM0
PLANT_ID=plant-1

# Optional overrides (defaults shown)
# SERIAL_BAUD=9600
# READ_INTERVAL=2
# SMOOTHING_WINDOW=5
# PHOTO_INTERVAL=3600
# UPLOAD_INTERVAL=10
# COMMAND_POLL_INTERVAL=15
# UPLOAD_MAX_RETRIES=5
# DRY_LIMIT=150
# WET_LIMIT=450
# DARK_LIMIT=200
# BRIGHT_LIMIT=600
# CAMERA_DEVICE=/dev/video0
# CAMERA_RESOLUTION=1280x720
# STREAM_FPS=5
# STREAM_IDLE_SECONDS=10
# STREAM_WIDTH=640
# STREAM_QUALITY=70
# WATERING_ENABLED=1
