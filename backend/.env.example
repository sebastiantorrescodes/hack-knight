# Copy to .env. API_KEY must match API_KEY in pi/.env
API_KEY=changeme

# AI agent: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Plant voice: API key from elevenlabs.io (Profile → API keys); voice ID from the Voice Library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional (defaults shown)
# DB_PATH=data/server.db
# PHOTO_DIR=data/photos
# CORS_ORIGINS=*

# GEMINI_MODEL=gemini-3.8-flash
# AGENT_MAX_STEPS=8
# AGENT_PLANT_ID=plant-1
# AGENT_CHECK_MINUTES=0        # e.g. 30 to let the agent check the plant on its own every 30 min
# PLANT_LAT=40.7365
# PLANT_LON=-73.8203
# NTFY_TOPIC=                  # pick something hard to guess, e.g. smart-garden-7f3k2
# MAX_WATER_SECONDS=5
# WATER_COOLDOWN_MINUTES=60
# STALE_READING_MINUTES=30
# ELEVENLABS_MODEL=eleven_flash_v2_5
# TTS_MAX_CHARS=600
# TTS_CACHE_DIR=data/tts
# DRY_LIMIT=150
# WET_LIMIT=450
